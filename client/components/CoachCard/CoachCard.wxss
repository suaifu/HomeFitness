/* components/CoachCard/CoachCard.wxss - 教练卡片组件样式 */

/* ============ 卡片模式 ============ */
.coach-card {
  display: inline-block;
  width: 480rpx;
  margin-right: 24rpx;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  vertical-align: top;
  transition: transform 0.2s;
}

.coach-card:active {
  transform: scale(0.98);
}

.coach-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  background: #f0f0f0;
}

.coach-info {
  width: 100%;
}

.coach-name {
  font-size: 30rpx;
}

.coach-specialty {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.coach-distance {
  margin-top: 6rpx;
}

/* ============ 简约模式 ============ */
.coach-simple {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border, #eee);
}

.coach-avatar-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.coach-simple-info {
  flex: 1;
  min-width: 0;
}

.coach-price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

/* ============ 横向模式 ============ */
.coach-horizontal {
  display: flex;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.coach-avatar-md {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.coach-horizontal-info {
  flex: 1;
  min-width: 0;
}

.coach-intro {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.coach-tags {
  display: flex;
  flex-wrap: wrap;
}

/* ============ 通用 ============ */
.rating {
  display: flex;
  align-items: center;
}

.rating-star {
  color: #FFD700;
  font-size: 24rpx;
  margin-right: 6rpx;
}

.rating-score {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.price {
  color: #FF6B6B;
  font-size: 36rpx;
  font-weight: 700;
}

.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #999;
}

.btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #FF6B6B;
  border-radius: 40rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border: 2rpx solid #FF6B6B;
}

.btn-outline::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-primary {
  background: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
}
