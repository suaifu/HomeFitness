<!-- components/image-uploader/image-uploader.wxml - 图片上传组件 -->
<view class="uploader">
  <!-- 图片列表 -->
  <view class="uploader-list" wx:if="{{ images.length > 0 }}">
    <view 
      class="uploader-item {{ disabled ? 'disabled' : '' }}"
      wx:for="{{ images }}"
      wx:key="index"
    >
      <!-- 图片预览 -->
      <image 
        class="uploader-image {{ customClass }}"
        src="{{ item.url }}"
        mode="{{ mode }}"
        lazy-load="{{ lazyLoad }}"
        bindtap="onPreview"
        data-index="{{ index }}"
      />
      
      <!-- 删除按钮 -->
      <view 
        class="uploader-remove" 
        wx:if="{{ !disabled && showRemove }}"
        catchtap="onRemove"
        data-index="{{ index }}"
      >
        <text class="icon-close">×</text>
      </view>
      
      <!-- 上传进度 -->
      <view class="uploader-progress" wx:if="{{ item.uploading }}">
        <view class="progress-circle">
          <text>{{ item.progress }}%</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view 
    class="uploader-add {{ disabled ? 'disabled' : '' }}"
    wx:if="{{ images.length < maxCount }}"
    bindtap="onChooseImage"
  >
    <view class="add-icon">
      <view class="line-h"></view>
      <view class="line-v"></view>
    </view>
    <text class="add-text">{{ placeholder }}</text>
  </view>

  <!-- 提示文字 -->
  <view class="uploader-tip" wx:if="{{ tip }}">
    <text>{{ tip }}</text>
  </view>
</view>
