/* app.wxss - 全局样式 */

/* 基础变量 */
page {
  --primary: #FF6B6B;
  --primary-light: #FF8E8E;
  --primary-dark: #E55555;
  --secondary: #4ECDC4;
  --accent: #FFE66D;
  --bg: #F5F5F5;
  --card: #FFFFFF;
  --text-dark: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --border: #EEEEEE;
  --success: #52C41A;
  --warning: #FAAD14;
  --error: #FF4D4F;

  font-size: 28rpx;
  color: var(--text-dark);
  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 图标字体 - 使用 SVG 内联图标 */
.iconfont {
  font-family: 'iconfont' !important;
  font-size: 32rpx;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 右箭头图标 */
.icon-right::before {
  content: '›';
  font-size: 36rpx;
  font-weight: bold;
}

/* 向下箭头 */
.icon-down::before {
  content: '⌄';
  font-size: 36rpx;
}

/* 勾选图标 */
.icon-check::before {
  content: '✓';
  color: var(--success);
}

/* 关闭图标 */
.icon-close::before {
  content: '✕';
}

/* 加号图标 */
.icon-plus::before {
  content: '+';
  font-size: 48rpx;
  font-weight: 300;
}

/* 容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 按钮 */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--primary);
  color: white;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--primary);
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  border: 2rpx solid var(--primary);
}

.btn-small {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

/* 头像 */
.avatar {
  border-radius: 50%;
  overflow: hidden;
}

.avatar-small {
  width: 64rpx;
  height: 64rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-primary {
  background: rgba(255, 107, 107, 0.1);
  color: var(--primary);
}

.tag-secondary {
  background: rgba(78, 205, 196, 0.1);
  color: var(--secondary);
}

/* 价格 */
.price {
  color: var(--primary);
  font-size: 36rpx;
  font-weight: 700;
}

.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-light);
}

/* Flex 布局 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-start {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

/* 间距 */
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mb-40 { margin-bottom: 40rpx; }
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-40 { margin-top: 40rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }
.ml-10 { margin-left: 10rpx; }

/* 文字 */
.text-center { text-align: center; }
.text-primary { color: var(--primary); }
.text-dark { color: var(--text-dark); }
.text-secondary { color: var(--text-secondary); }
.text-light { color: var(--text-light); }
.text-sm { font-size: 24rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.font-medium { font-weight: 500; }
.font-bold { font-weight: 700; }

/* 区块标题 */
.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-dark);
}

/* TabBar样式增强 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: white;
  display: flex;
  border-top: 1rpx solid var(--border);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: var(--text-light);
  margin-bottom: 30rpx;
}

.empty-text {
  color: var(--text-light);
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

.loading-spinner-small {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  display: inline-block;
  margin-right: 10rpx;
}

.loading-text {
  color: var(--text-light);
  font-size: 26rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 评分 */
.rating {
  display: flex;
  align-items: center;
}

.rating-star {
  color: #FFD700;
  font-size: 24rpx;
  margin-right: 6rpx;
}

.rating-score {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-dark);
}
