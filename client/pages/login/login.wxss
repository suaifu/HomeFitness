/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FF6B6B 0%, #FF8E8E 50%, #F5F5F5 50%, #F5F5F5 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部背景 */
.header-bg {
  height: 380rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.3);
}

.logo-area .logo {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  display: flex;
  align-items: center;
  justify-content: center;
}

.app-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 登录区域 */
.login-area {
  flex: 1;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 50rpx 40rpx;
  margin-top: -20rpx;
}

/* 登录方式切换 */
.login-tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 50rpx;
}

.tab-item {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.tab-icon {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
}

.tab-item.active .tab-icon {
  color: #FF6B6B;
}

/* 登录表单 */
.login-form {
  margin-bottom: 40rpx;
}

/* 手机号输入 */
.input-group {
  display: flex;
  align-items: center;
  height: 100rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 30rpx;
  color: #333;
  min-width: 100rpx;
}

.input-field {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #333;
}

.input-field.verify-code {
  flex: 1;
}

.verify-code-btn {
  background: #FF6B6B;
  color: #fff;
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.verify-code-btn.disabled {
  background: #ccc;
}

/* 登录按钮 */
.btn-login {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 20rpx;
}

.btn-login[disabled] {
  background: #ccc;
  color: #fff;
}

/* 微信登录按钮 */
.btn-wechat {
  width: 100%;
  height: 100rpx;
  background: #07C160;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 30rpx;
}

.btn-wechat::after {
  border: none;
}

.btn-wechat-outline {
  width: 100%;
  height: 100rpx;
  background: #fff;
  color: #333;
  font-size: 30rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ddd;
}

.btn-wechat-outline::after {
  border: none;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
}

.btn-icon-outline {
  font-size: 40rpx;
  margin-right: 10rpx;
  color: #07C160;
}

/* 协议区域 */
.agreement-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.checkbox-group {
  display: flex;
  align-items: center;
}

.checkbox-label {
  display: flex;
  align-items: center;
}

.checkbox-text {
  font-size: 26rpx;
  color: #999;
  margin-left: 10rpx;
}

.agreement-links {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.link {
  color: #FF6B6B;
  font-size: 26rpx;
}

.link-separator {
  color: #999;
  font-size: 26rpx;
  margin: 0 8rpx;
}

/* 底部 */
.footer {
  padding: 30rpx;
  display: flex;
  justify-content: center;
}

.skip-btn {
  padding: 20rpx 40rpx;
}

.skip-btn text {
  font-size: 28rpx;
  color: #999;
}
