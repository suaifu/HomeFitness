/* pages/user/address/edit/edit.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.form {
  background: #fff;
  margin-bottom: 24rpx;
}

.form-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  font-size: 30rpx;
  color: #333;
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.form-error {
  display: block;
  font-size: 24rpx;
  color: #FF6B6B;
  margin-top: 8rpx;
}

.region-display {
  display: flex;
  gap: 16rpx;
  font-size: 28rpx;
  color: #666;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-location {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 0;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-item {
  padding: 12rpx 32rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.tag-item.selected {
  background: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
  border: 1rpx solid #FF6B6B;
}

.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-item .form-label {
  margin-bottom: 0;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-save {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
}
