<!-- pages/user/address/edit/edit.wxml -->
<view class="container">
  <view class="form">
    <!-- 联系人 -->
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input
        class="form-input"
        placeholder="请输入联系人姓名"
        value="{{contactName}}"
        bindinput="onContactNameInput"
      />
      <text wx:if="{{errors.contactName}}" class="form-error">{{errors.contactName}}</text>
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号码"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
      <text wx:if="{{errors.phone}}" class="form-error">{{errors.phone}}</text>
    </view>

    <!-- 地区 -->
    <view class="form-item">
      <text class="form-label">地区</text>
      <view class="region-display">
        <text>{{province || '省'}}</text>
        <text>{{city || '市'}}</text>
        <text>{{district || '区/县'}}</text>
      </view>
    </view>

    <!-- 详细地址 -->
    <view class="form-item">
      <text class="form-label">详细地址</text>
      <view class="detail-row">
        <input
          class="form-input flex-1"
          placeholder="请输入详细地址"
          value="{{detail}}"
          bindinput="onDetailInput"
        />
        <button class="btn-location" bindtap="onChooseLocation">📍</button>
      </view>
      <text wx:if="{{errors.detail}}" class="form-error">{{errors.detail}}</text>
    </view>

    <!-- 地址标签 -->
    <view class="form-item">
      <text class="form-label">标签</text>
      <view class="tag-list">
        <view
          wx:for="{{tagOptions}}"
          wx:key="index"
          class="tag-item {{tag === item ? 'selected' : ''}}"
          data-tag="{{item}}"
          bindtap="onTagSelect"
        >
          {{item}}
        </view>
      </view>
    </view>

    <!-- 默认地址 -->
    <view class="form-item switch-item">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{isDefault}}" color="#FF6B6B" bindchange="onDefaultChange" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="bottom-bar">
    <button class="btn-save" bindtap="onSave">保存地址</button>
  </view>
</view>
