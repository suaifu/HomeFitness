/* pages/user/address/address.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 地址列表 */
.address-list {
  padding: 24rpx;
}

.address-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.address-item.selectable {
  border: 2rpx solid transparent;
}

.address-item.selectable:active {
  border-color: #FF6B6B;
}

.address-content {
  margin-bottom: 24rpx;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.contact-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.default-tag {
  font-size: 22rpx;
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 16rpx;
}

.address-detail {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.address-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 4rpx;
}

.address-actions {
  display: flex;
  border-top: 1rpx solid #eee;
  padding-top: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.action-btn text {
  padding: 8rpx 16rpx;
}

.action-btn text.active {
  color: #FF6B6B;
}

.action-btn.delete text {
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.bottom-bar button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
  border: 2rpx solid #FF6B6B;
  background: #fff;
  color: #FF6B6B;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-bar button .icon {
  margin-right: 8rpx;
}

.bottom-bar button:last-child {
  background: #FF6B6B;
  color: #fff;
}
