/* pages/user/favorites/favorites.wxss */

.favorite-card { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; }

.fav-main { display: flex; align-items: center; flex: 1; min-width: 0; }
.fav-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; margin-right: 20rpx; flex-shrink: 0; }
.fav-info { flex: 1; min-width: 0; }
.fav-name { display: block; font-size: 30rpx; color: var(--text-dark); margin-bottom: 4rpx; }
.fav-specialty { display: block; margin-bottom: 8rpx; }
.fav-meta { display: flex; align-items: center; gap: 20rpx; }
.star-active { color: #FFB800; font-size: 24rpx; }
.rating-score { font-size: 24rpx; color: var(--text-secondary); margin-left: 4rpx; }
.fav-price { font-size: 28rpx; font-weight: 600; color: var(--primary); }
.price-unit { font-size: 22rpx; color: var(--text-light); font-weight: 400; }

.fav-remove { padding: 16rpx; margin-left: 16rpx; flex-shrink: 0; }
.remove-icon { font-size: 28rpx; color: var(--text-light); font-weight: 300; }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.empty-image { width: 240rpx; height: 240rpx; margin-bottom: 30rpx; }
.empty-title { font-size: 32rpx; color: var(--text-dark); margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: var(--text-light); margin-bottom: 40rpx; }
.empty-state .btn-primary { padding: 20rpx 60rpx; }
