/* pages/user/coupons/coupons.wxss - 优惠券页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Tab 切换 */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.tab.active {
  color: #FF6B6B;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #FF6B6B;
  border-radius: 2rpx;
}

.tab-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 优惠券列表 */
.coupon-list {
  padding: 24rpx;
}

.coupon-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.coupon-item.available {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFFFFF 100%);
  border-left: 6rpx solid #FF6B6B;
}

.coupon-item.used {
  background: #f9f9f9;
  border-left: 6rpx solid #ccc;
  opacity: 0.7;
}

.coupon-item.expired {
  background: #f0f0f0;
  border-left: 6rpx solid #999;
  opacity: 0.6;
}

/* 左侧金额 */
.coupon-left {
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  background: rgba(255, 107, 107, 0.05);
}

.coupon-item.used .coupon-left {
  background: rgba(0, 0, 0, 0.02);
}

.coupon-item.expired .coupon-left {
  background: rgba(0, 0, 0, 0.02);
}

.coupon-amount {
  display: flex;
  align-items: baseline;
}

.amount-symbol {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.amount-value {
  font-size: 56rpx;
  color: #FF6B6B;
  font-weight: 700;
  line-height: 1;
}

.coupon-type {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 右侧信息 */
.coupon-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.coupon-info {
  flex: 1;
}

.coupon-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.coupon-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.coupon-valid {
  font-size: 22rpx;
  color: #999;
}

/* 操作按钮 */
.coupon-action {
  background: #FF6B6B;
  color: #fff;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.coupon-action:active {
  background: #E55555;
}

.coupon-status {
  background: #f0f0f0;
  color: #999;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.coupon-status.expired-text {
  color: #ccc;
}

/* 优惠券缺口圆形 */
.coupon-corner {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background: #f5f5f5;
  border-radius: 50%;
  right: 176rpx;
}

.coupon-corner.top {
  top: -12rpx;
}

.coupon-corner.bottom {
  bottom: -12rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-icon-img.grayscale {
  filter: grayscale(100%);
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 骨架屏 */
.skeleton-page {
  padding: 24rpx;
}

.skeleton-tabs {
  display: flex;
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.skeleton-tab {
  flex: 1;
  height: 32rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  margin: 0 16rpx;
}

.skeleton-coupon {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.skeleton-left {
  width: 200rpx;
  height: 160rpx;
  background: #f5f5f5;
}

.skeleton-right {
  flex: 1;
  padding: 32rpx;
}

.skeleton-line {
  height: 28rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-line.short {
  width: 60%;
}
