/* pages/user/settings/settings.wxss - 设置页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  padding: 0 16rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.setting-item:active {
  background-color: #fafafa;
}

.setting-item.no-border {
  border-bottom: none;
}

.setting-item.arrow {
  cursor: pointer;
}

.setting-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.setting-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
  width: 48rpx;
  text-align: center;
}

.setting-info {
  display: flex;
  flex-direction: column;
}

.setting-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.setting-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 退出登录 */
.logout-section {
  margin-top: 60rpx;
  padding: 0 32rpx;
}

.logout-btn {
  height: 88rpx;
  background: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: 500;
  transition: all 0.2s;
}

.logout-btn:active {
  background: #fff5f5;
  transform: scale(0.98);
}

/* 版本信息 */
.version-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
  padding-bottom: 40rpx;
}

.version-info text {
  font-size: 24rpx;
  color: #ccc;
}

.version-info text:first-child {
  margin-bottom: 8rpx;
}

/* 图标 */
.iconfont {
  font-size: 28rpx;
  color: #ccc;
}

.text-light {
  color: #ccc;
}

.text-sm {
  font-size: 26rpx;
}
