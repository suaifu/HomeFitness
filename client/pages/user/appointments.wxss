/* pages/user/appointments.wxss */

.tabs-header { display: flex; background: white; border-radius: 16rpx; margin-bottom: 30rpx; overflow: hidden; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: var(--text-secondary); position: relative; }
.tab-item.active { color: var(--primary); font-weight: 600; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 60rpx; height: 6rpx; background: var(--primary); border-radius: 3rpx; }

.appointment-card { background: white; border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.appointment-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.coach-info { display: flex; align-items: center; }
.coach-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; margin-right: 16rpx; }
.coach-name { font-size: 30rpx; font-weight: 500; }
.appointment-status { font-size: 26rpx; font-weight: 500; }
.appointment-status.upcoming { color: var(--primary); }
.appointment-status.completed { color: var(--success); }
.appointment-status.cancelled { color: var(--text-light); }

.appointment-content { padding: 16rpx 0; border-top: 1rpx solid var(--border); border-bottom: 1rpx solid var(--border); }
.course-title { font-size: 28rpx; display: block; margin-bottom: 12rpx; }
.appointment-time, .appointment-address { display: flex; align-items: center; font-size: 24rpx; color: var(--text-secondary); margin-bottom: 8rpx; }
.appointment-time .iconfont, .appointment-address .iconfont { font-size: 28rpx; margin-right: 8rpx; color: var(--primary); }

.appointment-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 20rpx; }
.action-btns { display: flex; gap: 16rpx; }
