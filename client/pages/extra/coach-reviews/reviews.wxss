/* pages/coach/reviews/reviews.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 评分概览卡片 */
.stats-card {
  background: #fff;
  padding: 40rpx;
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.stats-left {
  width: 200rpx;
  text-align: center;
  border-right: 1rpx solid #eee;
  padding-right: 40rpx;
}

.avg-score {
  font-size: 72rpx;
  font-weight: bold;
  color: #FF6B6B;
  line-height: 1;
}

.total-count {
  font-size: 24rpx;
  color: #999;
  margin: 12rpx 0;
}

.stats-right {
  flex: 1;
  padding-left: 40rpx;
}

.distribution-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.distribution-item:last-child {
  margin-bottom: 0;
}

.star-label {
  width: 60rpx;
  color: #666;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #eee;
  border-radius: 6rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFB800, #FFD700);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.percent-text {
  width: 60rpx;
  text-align: right;
  color: #999;
}

/* 评价列表 */
.reviews-list {
  padding: 0 24rpx;
}

.review-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
}

.user-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.review-time {
  font-size: 24rpx;
  color: #999;
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  font-size: 22rpx;
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.review-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 加载状态 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-evaluate {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-write-review {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
}
