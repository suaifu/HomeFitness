/* pages/course/booking.wxss */

.course-header { position: relative; padding: 0; overflow: hidden; border-radius: 16rpx; }
.course-image { width: 100%; height: 300rpx; }
.course-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 30rpx; background: linear-gradient(transparent, rgba(0,0,0,0.7)); }
.course-title { color: white; display: block; }
.course-subtitle { color: rgba(255,255,255,0.8); display: block; margin-top: 6rpx; }

.date-scroll { white-space: nowrap; }
.date-item { display: inline-flex; flex-direction: column; align-items: center; padding: 20rpx 30rpx; margin-right: 16rpx; border-radius: 12rpx; background: var(--bg); border: 2rpx solid transparent; }
.date-item.active { border-color: var(--primary); background: rgba(255,107,107,0.05); }
.date-weekday { font-size: 22rpx; color: var(--text-light); }
.date-day { font-size: 28rpx; color: var(--text-dark); margin-top: 6rpx; }

.time-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; }
.time-slot { text-align: center; padding: 24rpx; border-radius: 12rpx; background: var(--bg); font-size: 26rpx; border: 2rpx solid transparent; }
.time-slot.active { border-color: var(--primary); color: var(--primary); background: rgba(255,107,107,0.05); }
.time-slot.disabled { color: var(--text-light); }

.coach-select-item { display: flex; align-items: center; padding: 24rpx; margin-bottom: 16rpx; border-radius: 12rpx; border: 2rpx solid var(--border); }
.coach-select-item.selected { border-color: var(--primary); background: rgba(255,107,107,0.03); }
.coach-select-info { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; }

.address-info { display: flex; align-items: center; }
.address-detail { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; }
.address-placeholder { display: flex; justify-content: space-between; align-items: center; }

.remark-input { width: 100%; height: 160rpx; font-size: 28rpx; padding: 20rpx; background: var(--bg); border-radius: 12rpx; box-sizing: border-box; }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: 20rpx 30rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: white; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05); }
.bottom-btn { padding: 20rpx 60rpx; }
