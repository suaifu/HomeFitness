/* pages/coach/evaluate/evaluate.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 教练信息卡片 */
.coach-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.coach-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #f0f0f0;
}

.coach-info {
  display: flex;
  flex-direction: column;
}

.coach-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.coach-label {
  font-size: 26rpx;
  color: #999;
}

/* 评分区域 */
.rating-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

.rating-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.rating-text {
  font-size: 28rpx;
  color: #FF6B6B;
}

/* 标签区域 */
.tags-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-item {
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.tag-item.selected {
  background: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
  border-color: #FF6B6B;
}

/* 内容区域 */
.content-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.content-input {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.word-count {
  position: absolute;
  right: 48rpx;
  bottom: 48rpx;
  font-size: 24rpx;
  color: #999;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
}

.btn-submit.disabled {
  background: #ccc;
}
