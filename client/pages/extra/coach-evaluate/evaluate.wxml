<!-- pages/coach/evaluate/evaluate.wxml -->
<view class="container">
  <!-- 教练信息 -->
  <view class="coach-card">
    <image
      class="coach-avatar"
      src="/images/default-coach.png"
      mode="aspectFill"
    />
    <view class="coach-info">
      <text class="coach-name">{{coachName}}</text>
      <text class="coach-label">为您提供服务</text>
    </view>
  </view>

  <!-- 评分 -->
  <view class="rating-section">
    <text class="section-title">服务评分</text>
    <view class="rating-box">
      <star-rating
        value="{{rating}}"
        size="56rpx"
        gap="16rpx"
        bind:change="onRatingChange"
      />
      <text class="rating-text">{{ratingText}}</text>
    </view>
  </view>

  <!-- 标签选择 -->
  <view class="tags-section">
    <text class="section-title">选择标签（可选，最多3个）</text>
    <view class="tags-grid">
      <view
        wx:for="{{tags}}"
        wx:key="id"
        class="tag-item {{selectedTags.includes(item.id) ? 'selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTagTap"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 评价内容 -->
  <view class="content-section">
    <text class="section-title">评价内容（可选）</text>
    <textarea
      class="content-input"
      placeholder="分享您的健身体验，帮助更多需要的人..."
      maxlength="500"
      value="{{content}}"
      bindinput="onContentInput"
    />
    <text class="word-count">{{content.length}}/500</text>
  </view>

  <!-- 提交按钮 -->
  <view class="bottom-bar">
    <button
      class="btn-submit {{submitting ? 'disabled' : ''}}"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >
      {{submitting ? '提交中...' : '提交评价'}}
    </button>
  </view>
</view>
