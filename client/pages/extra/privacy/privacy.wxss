/* pages/privacy/privacy.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.content {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.last-update {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.section-content {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  text-align: justify;
}

.contact-btn {
  margin-top: 24rpx;
}

.btn-copy {
  background: #FF6B6B;
  color: #fff;
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
}
