/* pages/coach/list.wxss */

.search-bar { display: flex; align-items: center; background: white; border-radius: 40rpx; padding: 16rpx 24rpx; margin-bottom: 30rpx; }
.search-bar .iconfont { margin-right: 16rpx; color: var(--text-light); }
.search-input { flex: 1; font-size: 28rpx; }

.filter-bar { display: flex; justify-content: space-around; margin-bottom: 30rpx; background: white; border-radius: 16rpx; padding: 20rpx; }
.filter-item { font-size: 26rpx; color: var(--text-secondary); display: flex; align-items: center; }
.filter-item.active { color: var(--primary); font-weight: 600; }

.coach-list-item { display: flex; background: white; border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.coach-list-avatar { width: 140rpx; height: 140rpx; border-radius: 50%; margin-right: 24rpx; flex-shrink: 0; }
.coach-list-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.coach-list-name { font-size: 32rpx; font-weight: 600; }
.coach-list-title { font-size: 24rpx; color: var(--text-light); margin-top: 6rpx; }
.coach-list-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.distance { font-size: 24rpx; color: var(--text-light); }

.load-more { text-align: center; padding: 30rpx; color: var(--text-light); font-size: 26rpx; }
