<!--pages/coach/list.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="iconfont">🔍</text>
    <input
      class="search-input"
      placeholder="搜索教练姓名、专长"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
      confirm-type="search"
      focus="{{searchFocus}}"
    />
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view
      class="filter-item {{filters.sortBy === 'rating' ? 'active' : ''}}"
      data-type="sortBy"
      data-value="rating"
      bindtap="onSelectFilter"
    >评分优先</view>
    <view
      class="filter-item {{filters.sortBy === 'price_asc' ? 'active' : ''}}"
      data-type="sortBy"
      data-value="price_asc"
      bindtap="onSelectFilter"
    >价格最低</view>
    <view
      class="filter-item {{filters.sortBy === 'price_desc' ? 'active' : ''}}"
      data-type="sortBy"
      data-value="price_desc"
      bindtap="onSelectFilter"
    >价格最高</view>
    <view
      class="filter-item {{filters.sortBy === 'distance' ? 'active' : ''}}"
      data-type="sortBy"
      data-value="distance"
      bindtap="onSelectFilter"
    >距离最近</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadFailed}}" class="empty-state">
    <text class="empty-icon">!</text>
    <text class="empty-text">加载失败，请重试</text>
    <view class="btn-primary" bindtap="onRetry">重新加载</view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{coaches.length === 0 && !loading}}" class="empty-state">
    <text class="empty-icon">🏋️</text>
    <text class="empty-text">{{searchKeyword ? '未找到相关教练' : '暂无教练'}}</text>
    <view wx:if="{{searchKeyword}}" class="btn-primary" bindtap="onResetFilter">清除搜索</view>
  </view>

  <!-- 教练列表 -->
  <block wx:else>
    <view
      wx:for="{{coaches}}"
      wx:key="id"
      class="coach-list-item"
      data-id="{{item.id}}"
      bindtap="onCoachTap"
    >
      <image
        class="coach-list-avatar"
        src="{{item.avatar || '/images/default-coach.png'}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="coach-list-info">
        <text class="coach-list-name">{{item.name}}</text>
        <text class="coach-list-title">{{item.specialty || item.title || '专业私教'}}</text>
        <view class="coach-list-bottom">
          <view class="rating">
            <text class="rating-star">★</text>
            <text class="rating-score">{{item.rating}}</text>
          </view>
          <view>
            <text class="price">¥{{item.pricePerSession || item.price}}</text>
            <text class="price-unit">/次</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loadingMore}}" class="load-more">
      <view class="loading-spinner-small"></view>
      <text>加载更多...</text>
    </view>
    <view wx:elif="{{noMore}}" class="load-more">
      没有更多教练了
    </view>
  </block>
</view>
