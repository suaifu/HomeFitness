/* pages/order/list.wxss */

.status-tabs { display: flex; background: white; border-radius: 16rpx; padding: 8rpx; margin-bottom: 30rpx; overflow-x: auto; }
.tab-item { flex-shrink: 0; text-align: center; padding: 16rpx 24rpx; font-size: 26rpx; color: var(--text-secondary); border-radius: 12rpx; position: relative; }
.tab-item.active { background: rgba(255,107,107,0.1); color: var(--primary); font-weight: 600; }
.tab-badge { position: absolute; top: 4rpx; right: 4rpx; background: var(--error); color: white; font-size: 18rpx; min-width: 28rpx; height: 28rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; }

.order-card { background: white; border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.order-header { display: flex; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--border); }
.order-id { font-size: 24rpx; color: var(--text-light); }
.order-status { font-size: 26rpx; font-weight: 500; }
.order-status.pending_payment { color: var(--warning); }
.order-status.paid { color: var(--primary); }
.order-status.completed { color: var(--success); }
.order-status.cancelled { color: var(--text-light); }

.order-content { display: flex; padding: 24rpx 0; border-bottom: 1rpx solid var(--border); }
.order-avatar { width: 140rpx; height: 140rpx; border-radius: 12rpx; margin-right: 24rpx; flex-shrink: 0; }
.order-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.order-title { font-size: 30rpx; font-weight: 500; }
.order-coach { font-size: 24rpx; color: var(--text-light); margin-top: 8rpx; }
.order-time { font-size: 24rpx; color: var(--text-light); margin-top: 4rpx; }
.order-price { display: flex; align-items: center; margin-left: 20rpx; }

.order-actions { display: flex; justify-content: flex-end; gap: 16rpx; padding-top: 20rpx; }
.load-more, .no-more { text-align: center; padding: 30rpx; color: var(--text-light); font-size: 26rpx; }
